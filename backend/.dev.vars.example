# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars. These values are for LOCAL use only.
# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ENVIRONMENT=development
ACCESS_DEV_BYPASS=true
OWNER_EMAILS=owner@example.invalid
COORDINATOR_EMAILS=coordinator@example.invalid

CREDENTIAL_PEPPER=replace-with-64-hex-characters-from-the-command-above
SESSION_SECRET=replace-with-64-hex-characters-from-the-command-above

MAIL_PROVIDER=stub
# MAIL_WEBHOOK_URL=https://mail-relay.example.invalid/send
# MAIL_WEBHOOK_TOKEN=replace-me

# Optional local overrides
# RSVP_CUTOFF_AT=2026-11-20T23:59:59-06:00
# SITE_ORIGIN=http://127.0.0.1:8080
